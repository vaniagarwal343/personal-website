{
  "name": "nextjs-sass-starter",
  "description": "A starting repository for the Internet Development Studio team.",
  "engines": {
    "node": ">=20.9"
  },
  "license": "MIT",
  "version": "1.0.0",
  "scripts": {
    "dev": "next -p 10000",
    "build": "next build",
    "start": "PORT=10000 next start",
    "lint": "eslint \"app/(front)\" components/front content scripts eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:content": "ts-node --transpile-only -O \"{\\\"module\\\":\\\"commonjs\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/check-content.ts",
    "lint:all": "eslint ."
  },
  "dependencies": {
    "d3": "^7.9.0",
    "next": "^16.1.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "1.94.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
